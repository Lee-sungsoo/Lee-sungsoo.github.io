{% comment %}
  Education rows for the home tab, in the same row design as the
  publications: the degree on the left, the period on the right, the institution
  in one muted line under them. Data comes from _data/education.yml, written by
  scripts/notion_sync.py from the Notion CV Entries database. Styles live in
  _layouts/about.liquid.
{% endcomment %}
<ul class="education-list">
  {% for entry in site.data.education %}
    <li class="pub-row">
      <div class="pub-title">{{ entry.degree }}</div>
      {% if entry.period %}
        <span class="pub-when">{{ entry.period }}</span>
      {% endif %}
      {% if entry.institution %}
        <div class="pub-meta">{{ entry.institution }}</div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
