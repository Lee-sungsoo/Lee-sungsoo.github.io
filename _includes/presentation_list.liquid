{% comment %}
  Presentation rows for the research tab, in the same row design as the
  publications: title, a type pill (Oral / Poster) on the right, the authors
  with the site owner in bold, then event, location and date in one muted line.
  Data comes from _data/presentations.yml, written by scripts/notion_sync.py
  from the Notion Research database. Styles live in _layouts/about.liquid.
{% endcomment %}
{% assign self_names = "Sungsoo Lee|이성수" | split: "|" %}
<ul class="presentation-list">
  {% for talk in site.data.presentations %}
    <li class="pub-row">
      <div class="pub-title">{{ talk.title }}</div>
      {% if talk.type %}
        <span class="pub-type">{{ talk.type }}</span>
      {% endif %}
      {% if talk.authors %}
        {% assign names = talk.authors | split: "," %}
        <div class="pub-authors">
          {%- for raw_name in names -%}
            {%- assign name = raw_name | strip -%}
            {%- if self_names contains name -%}
              <span class="pub-self">{{ name }}</span>
            {%- else -%}
              {{ name }}
            {%- endif -%}
            {%- unless forloop.last -%}{{ ", " }}{%- endunless -%}
          {%- endfor -%}
        </div>
      {% endif %}
      {% assign meta_parts = "" | split: "" %}
      {% if talk.event %}
        {% assign meta_parts = meta_parts | push: talk.event %}
      {% endif %}
      {% if talk.location %}
        {% assign meta_parts = meta_parts | push: talk.location %}
      {% endif %}
      {% if talk.date %}
        {% assign meta_parts = meta_parts | push: talk.date %}
      {% endif %}
      {% if meta_parts.size > 0 %}
        <div class="pub-meta">{{ meta_parts | join: " · " }}</div>
      {% endif %}
    </li>
  {% endfor %}
</ul>
