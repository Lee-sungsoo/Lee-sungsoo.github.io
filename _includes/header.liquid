{% comment %}
  Local override of al_folio_core's _includes/header.liquid. The menu is the four
  `nav: true` pages plus the theme toggle, rendered as one always-visible row:
  the brand link (the name already sits in the sidebar), the search button and
  the hamburger/collapse machinery are dropped, because the theme hides
  `.collapse` with an `!important` inside a cascade layer that a local rule
  cannot outrank. The row wraps instead of collapsing; see _layouts/about.liquid
  for its styles.
{% endcomment %}
{% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <ul class="navbar-nav navbar-menu-list">
        {% for p in nav_pages %}
          {% assign is_current = false %}
          {% if page.url == p.url %}
            {% assign is_current = true %}
          {% endif %}
          <li class="nav-item {% if is_current %}active{% endif %}">
            <a class="nav-link" href="{{ p.url | relative_url }}">
              {{- p.title }}
              {% if is_current %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>
        {% endfor %}
        {% if site.enable_darkmode %}
          <!-- Toogle theme mode -->
          <li class="toggle-container">
            <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
              <i class="fa-half-sun-moon" id="light-toggle-system"></i>
              <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
              <i class="fa-solid fa-sun" id="light-toggle-light"></i>
            </button>
          </li>
        {% endif %}
      </ul>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
