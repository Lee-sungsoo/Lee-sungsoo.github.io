---
layout: default
---
{% comment %}
  Shared shell for every page of the site (home, publications, projects, cv),
  replacing al_folio_core's about layout: a sticky sidebar carries the photo,
  name, role, affiliation and social links, and the page body fills the column
  next to it. The sidebar is written once here and its data comes from
  _data/profile.yml, so no page repeats it. Social links are rendered from
  _data/socials.yml (instead of the jekyll-socials tag) so each icon can carry
  its brand color. Everything else uses the theme's CSS variables so dark mode
  keeps working.
{% endcomment %}
{% assign profile = site.data.profile %}
{% assign photo = profile.image | prepend: 'assets/img/' %}
{% assign socials = site.data.socials %}
{% capture sizes %}(min-width: 900px) 230px, 170px{% endcapture %}
<div class="home">
  <aside class="home-side">
    {% include figure.liquid loading="eager" path=photo class="home-photo" sizes=sizes alt=site.title cache_bust=true %}
    <h1 class="home-name">{{ site.title }}</h1>
    {% if profile.role %}
      <p class="home-role">{{ profile.role }}</p>
    {% endif %}
    {% if profile.affiliation %}
      <p class="home-affil">
        {% for line in profile.affiliation %}
          {{ line }}{% unless forloop.last %}<br>{% endunless %}
        {% endfor %}
      </p>
    {% endif %}
    {% if profile.interests %}
      <p class="home-interests">{% for item in profile.interests %}<span>{{ item }}</span>{% endfor %}</p>
    {% endif %}
    <div class="home-social">
      {% if socials.email %}
        <a class="home-social-email" href="mailto:{{ socials.email }}" title="Email" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
      {% endif %}
      {% if socials.github_username %}
        <a class="home-social-github" href="https://github.com/{{ socials.github_username }}" title="GitHub" aria-label="GitHub" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-github"></i></a>
      {% endif %}
      {% if socials.linkedin_username %}
        <a class="home-social-linkedin" href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" title="LinkedIn" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin"></i></a>
      {% endif %}
      {% if socials.scholar_userid %}
        <a class="home-social-scholar" href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}" title="Google Scholar" aria-label="Google Scholar" target="_blank" rel="noopener noreferrer"><i class="ai ai-google-scholar"></i></a>
      {% endif %}
    </div>
  </aside>
  <div class="home-main">
    {{ content }}
  </div>
</div>

<style>
  /* Accent color: blue instead of the theme's purple (light) / cyan (dark).
     The theme reads both variables for pills, link hovers and the toggle. */
  :root {
    --global-theme-color: #0a66c2;
    --global-hover-color: #0a66c2;
  }

  html[data-theme="dark"] {
    --global-theme-color: #58a6ff;
    --global-hover-color: #58a6ff;
  }

  .home {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-top: 0.5rem;
  }

  /* Sidebar: centered on narrow screens, sticky left column on wide ones. */
  .home-side {
    text-align: center;
  }

  .home-side figure {
    margin: 0 auto 1.25rem;
    width: 170px;
  }

  .home-photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .home-name {
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.35rem;
    color: var(--global-text-color);
  }

  .home-role {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--global-text-color);
  }

  .home-affil {
    margin: 0.3rem 0 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--global-text-color-light);
  }

  .home-interests {
    margin: 0.7rem 0 1.1rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--global-text-color-light);
  }

  /* Each keyword is an unbreakable unit and carries its own trailing dot, so a
     wrapped line never starts with one (the build strips whitespace between tags). */
  .home-interests span {
    display: inline-block;
  }

  .home-interests span:not(:last-child)::after {
    content: "\00a0\00b7";
    margin-right: 0.4em;
  }

  .home-social {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .home-social a {
    display: inline-flex;
    font-size: 1.35rem;
    line-height: 1;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .home-social a:hover {
    opacity: 0.7;
    text-decoration: none;
  }

  /* Brand colors, one per service. */
  .home-social-email {
    color: #d93025;
  }

  .home-social-github {
    color: #24292f;
  }

  html[data-theme="dark"] .home-social-github {
    color: #e6edf3;
  }

  .home-social-linkedin {
    color: #0a66c2;
  }

  .home-social-scholar {
    color: #4285f4;
  }

  @media (min-width: 900px) {
    .home {
      grid-template-columns: 230px minmax(0, 1fr);
      gap: 4.5rem;
      align-items: start;
    }

    .home-side {
      text-align: left;
      position: sticky;
      top: 5.5rem;
    }

    .home-side figure {
      margin: 0 0 1.25rem;
      width: 100%;
    }

    .home-social {
      justify-content: flex-start;
    }
  }

  /* Main column: one section per block, a thin rule under each heading. */
  .home-main section + section {
    margin-top: 3rem;
  }

  .home-main h2 {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .home-count {
    margin-left: 0.45rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--global-text-color-light);
  }

  .home-main #about p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .home-main #about p + p {
    margin-top: 1rem;
  }

  /* Education, honors, publications, patents and projects share one row design:
     title on the left, a small pill or date on the right, muted detail lines
     beneath, rules between rows. */
  .home-main .publications ol.bibliography,
  .education-list,
  .honors-list,
  .patent-list,
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .home-main .publications ol.bibliography li {
    margin: 0;
    padding: 0;
  }

  .pub-row,
  .project-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.2rem 1rem;
    align-items: start;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .home-main .publications ol.bibliography li:last-child .pub-row,
  .education-list li:last-child,
  .honors-list li:last-child,
  .patent-list li:last-child,
  .project-list li:last-child {
    border-bottom: 0;
  }

  .pub-title,
  .project-title {
    font-weight: 500;
  }

  .pub-type,
  .project-status {
    margin-top: 0.15rem;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--global-divider-color);
    color: var(--global-text-color-light);
  }

  .pub-type.granted,
  .project-status.ongoing {
    color: var(--global-theme-color);
    border-color: var(--global-theme-color);
  }

  /* Education and honors carry a plain date in the right column, not a pill. */
  .pub-when {
    white-space: nowrap;
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }

  .pub-authors {
    grid-column: 1 / -1;
    font-size: 0.9rem;
  }

  .pub-self {
    font-weight: 600;
  }

  .pub-meta,
  .project-meta {
    grid-column: 1 / -1;
    font-size: 0.85rem;
    color: var(--global-text-color-light);
  }

  .pub-meta a {
    color: var(--global-text-color-light);
    text-decoration: underline;
    text-decoration-color: var(--global-divider-color);
    text-underline-offset: 0.15em;
  }

  .pub-meta a:hover {
    color: var(--global-theme-color);
    text-decoration-color: var(--global-theme-color);
  }

  /* CV tab: the embedded PDF fills the column, tall enough to read a page
     without scrolling the viewer itself. */
  .cv-embed {
    display: block;
    width: 100%;
    height: min(80vh, 900px);
    border: 1px solid var(--global-divider-color);
    border-radius: 6px;
  }

  .cv-download {
    margin-left: 0.6rem;
    vertical-align: middle;
    font-size: 0.75rem;
  }

  /* The navbar (see _includes/header.liquid) holds the four page links and the
     theme toggle. The theme stacks the list into a column below 576px and its
     hamburger cannot be revived from here (the `.collapse` rule that hides the
     menu is `!important` inside a cascade layer), so keep the links on one
     right-aligned row that wraps instead. These rules are unlayered, which is
     what lets them win over the theme's layered defaults. */
  .navbar .container .navbar-menu-list {
    width: auto;
    margin-left: auto;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0 1.1rem;
  }

  .navbar .container .navbar-menu-list .nav-link {
    padding: 0.5rem 0;
  }

  /* The theme drops the navbar's side padding on small screens, which leaves the
     links flush against the edge now that there is more than one of them. */
  @media (max-width: 575.98px) {
    .navbar .container {
      padding-left: 15px;
      padding-right: 15px;
    }
  }
</style>
